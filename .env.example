# ──────────────────────────────────────────────────────────────
# Ecom Profit — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# ──────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="Ecom Profit"

# Database (Neon/Supabase Postgres). Use the pooled URL for the app,
# the direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_URL=http://localhost:3000

# ── Payments ──────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Razorpay (PAUSED — kept for future re-enable)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# PhonePe (ACTIVE). Defaults are the public UAT/sandbox creds.
PHONEPE_MERCHANT_ID="PGTESTPAYUAT"
PHONEPE_SALT_KEY="099eb0cd-02cf-4e2a-8aca-3e6c6aff0399"
PHONEPE_SALT_INDEX="1"
PHONEPE_HOST="https://api-preprod.phonepe.com/apis/pg-sandbox"

# ── Email (SMTP) ──────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"            # true for port 465
SMTP_USER="apikey-or-username"
SMTP_PASSWORD="..."
EMAIL_FROM="Ecom Profit <no-reply@ecomprofit.example>"

# ── Seller / GST details (for invoices) ───────────────────────
SELLER_LEGAL_NAME="Your Company Pvt Ltd"
SELLER_GSTIN="29ABCDE1234F1Z5"
SELLER_STATE_CODE="29"         # GST state code, e.g. 29 = Karnataka
SELLER_ADDRESS="Street, City, State, PIN"
SELLER_EMAIL="billing@ecomprofit.example"
SELLER_SAC="998314"            # SAC for IT/SaaS services
INVOICE_PREFIX="EP"
GST_RATE="18"                  # default GST percent applied to plans

# ── Admin bootstrap ───────────────────────────────────────────
# Comma-separated emails auto-granted admin role on signup.
ADMIN_EMAILS="admin@ecomprofit.example"

# ── Cron protection ───────────────────────────────────────────
# Bearer token required to call /api/cron/* endpoints.
CRON_SECRET="replace-me-with-a-long-random-string"
